# OPENROUTER_API_KEY: main AI provider for French explanations (free models).
# Create a free key at https://openrouter.ai/keys. No billing needed.
# Free limits without purchased credits: about 50 requests/day and 20/minute.
# Answers are cached on disk (.cache/explanations.json), so repeats are free.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODELS (optional): comma-separated free models to try in order.
# The free list changes often; see https://openrouter.ai/models?q=free
# OPENROUTER_MODELS="nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free"

# GEMINI_API_KEY (optional): backup provider, used only if every OpenRouter model fails.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
